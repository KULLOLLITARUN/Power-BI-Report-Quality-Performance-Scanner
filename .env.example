# Copy this file to .env and paste your own key(s) in. Never commit .env —
# it's already in .gitignore.
#
# Only used by `pbiscan mcp`'s optional suggest_dax_rewrite tool. Every other
# pbiscan command (scan, studio, diff, fix) ignores this file entirely and
# never makes a network call — the core scanner stays 100% deterministic and
# AI-free regardless of whether this is set.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional — defaults to llama-3.3-70b-versatile if unset.
# GROQ_MODEL=llama-3.3-70b-versatile
