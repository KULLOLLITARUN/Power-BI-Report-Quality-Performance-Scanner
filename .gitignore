# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Node / Frontend dependencies & builds
node_modules/
.npm/

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/
# Allow the compiled Studio UI dist to be tracked (required for pip install)
!pbiscan/studio/dist/
!pbiscan/studio/dist/**

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Output & temporary files
!studio-ui/index.html
scan_report*.html
output*.html
*.log
scratch/
corpus_intelligence.json
real_world_coverage_audit_v2.json
diff_*.json
diff_*.md

# Internal documentation / build notes
!docs/*.md

# Local secrets — never commit real API keys. .env.example is the tracked
# template; .env is where you paste your own GROQ_API_KEY locally.
.env
.env.local
