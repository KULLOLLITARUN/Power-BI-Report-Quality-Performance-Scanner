<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>pbiscan — {{ meta.report_name }} Quality Audit</title>
  <meta name="description" content="Power BI Report Quality Audit for {{ meta.report_name }} — generated by pbiscan {{ meta.scanner_version }}">
  <style>
    /* ------------------------------------------------------------------ */
    /* Design system tokens                                                 */
    /* ------------------------------------------------------------------ */
    :root {
      --bg:          #0d1117;
      --bg-card:     #161b22;
      --bg-card2:    #1c2230;
      --border:      #30363d;
      --border-light:#21262d;
      --text:        #e6edf3;
      --text-muted:  #8b949e;
      --text-dim:    #6e7681;
      --accent:      #58a6ff;
      --accent-glow: rgba(88,166,255,0.15);

      --sev-critical:#ef4444;
      --sev-high:    #f97316;
      --sev-medium:  #f59e0b;
      --sev-warning: #eab308;
      --sev-advisory:#6366f1;
      --sev-low:     #94a3b8;

      --cat-model:   #3b82f6;
      --cat-dax:     #8b5cf6;
      --cat-report:  #06b6d4;

      --radius:      12px;
      --radius-sm:   6px;
      --transition:  0.2s ease;
    }

    /* ------------------------------------------------------------------ */
    /* Reset & base                                                         */
    /* ------------------------------------------------------------------ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      line-height: 1.6;
      font-size: 14px;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* ------------------------------------------------------------------ */
    /* Layout                                                               */
    /* ------------------------------------------------------------------ */
    .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

    /* ------------------------------------------------------------------ */
    /* Header                                                               */
    /* ------------------------------------------------------------------ */
    header {
      background: linear-gradient(135deg, #0d1117 0%, #161b22 50%, #0d1117 100%);
      border-bottom: 1px solid var(--border);
      padding: 32px 0 24px;
      position: relative;
      overflow: hidden;
    }
    header::before {
      content: '';
      position: absolute;
      top: -60px; left: -60px;
      width: 300px; height: 300px;
      background: radial-gradient(circle, rgba(88,166,255,0.08) 0%, transparent 70%);
      pointer-events: none;
    }
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }
    .brand { display: flex; align-items: center; gap: 12px; }
    .brand-icon {
      width: 40px; height: 40px;
      background: linear-gradient(135deg, #1d4ed8, #3b82f6);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 18px; color: white;
      box-shadow: 0 4px 12px rgba(59,130,246,0.3);
    }
    .brand-name { font-size: 22px; font-weight: 700; color: var(--text); }
    .brand-sub { font-size: 12px; color: var(--text-muted); margin-top: 1px; }
    .header-meta { text-align: right; color: var(--text-muted); font-size: 12px; }
    .header-meta div { margin-top: 2px; }

    /* ------------------------------------------------------------------ */
    /* Health score hero                                                    */
    /* ------------------------------------------------------------------ */
    .score-hero {
      padding: 40px 0 32px;
      text-align: center;
    }
    .score-ring {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 160px; height: 160px;
      margin-bottom: 16px;
    }
    .score-ring svg { transform: rotate(-90deg); }
    .score-ring-bg { fill: none; stroke: var(--border); stroke-width: 10; }
    .score-ring-fill {
      fill: none;
      stroke-width: 10;
      stroke-linecap: round;
      stroke-dasharray: 439.82;
      transition: stroke-dashoffset 1s ease;
    }
    .score-value {
      position: absolute;
      font-size: 44px;
      font-weight: 800;
      letter-spacing: -2px;
    }
    .score-label { font-size: 13px; color: var(--text-muted); margin-top: 4px; }
    .score-label strong { color: var(--text); }

    /* Category score cards */
    .cat-scores {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      max-width: 600px;
      margin: 28px auto 0;
    }
    .cat-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px 16px;
      text-align: center;
      transition: transform var(--transition), box-shadow var(--transition);
    }
    .cat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.4); }
    .cat-name {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin-bottom: 8px;
    }
    .cat-score {
      font-size: 36px;
      font-weight: 800;
      letter-spacing: -1px;
    }
    .cat-bar {
      height: 4px;
      background: var(--border);
      border-radius: 2px;
      margin-top: 12px;
      overflow: hidden;
    }
    .cat-bar-fill {
      height: 100%;
      border-radius: 2px;
      transition: width 1s ease;
    }

    /* ------------------------------------------------------------------ */
    /* Summary strip                                                        */
    /* ------------------------------------------------------------------ */
    .summary-strip {
      display: flex;
      gap: 12px;
      padding: 20px 0;
      flex-wrap: wrap;
    }
    .stat-pill {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 50px;
      padding: 6px 16px;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .stat-pill .count {
      font-weight: 700;
      font-size: 15px;
    }
    .stat-pill .label { color: var(--text-muted); }

    /* ------------------------------------------------------------------ */
    /* Filters                                                              */
    /* ------------------------------------------------------------------ */
    .filters-bar {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px 20px;
      margin-bottom: 20px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items: center;
    }
    .filter-label { font-size: 12px; color: var(--text-muted); font-weight: 500; }
    .filter-btn {
      background: var(--bg-card2);
      border: 1px solid var(--border);
      border-radius: 50px;
      color: var(--text);
      padding: 5px 14px;
      font-size: 12px;
      cursor: pointer;
      transition: all var(--transition);
      font-family: inherit;
    }
    .filter-btn:hover, .filter-btn.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }
    .filter-divider { width: 1px; height: 20px; background: var(--border); }

    /* ------------------------------------------------------------------ */
    /* Findings                                                             */
    /* ------------------------------------------------------------------ */
    .section-title {
      font-size: 18px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .section-title .badge {
      background: var(--bg-card2);
      border: 1px solid var(--border);
      border-radius: 50px;
      padding: 2px 10px;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
    }

    .finding {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin-bottom: 12px;
      overflow: hidden;
      transition: box-shadow var(--transition);
    }
    .finding:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.3); }
    .finding.hidden { display: none; }

    .finding-header {
      padding: 16px 20px;
      display: flex;
      align-items: flex-start;
      gap: 14px;
      cursor: pointer;
      user-select: none;
    }
    .finding-header:hover { background: var(--bg-card2); }

    .sev-badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .cat-badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.04em;
      white-space: nowrap;
      flex-shrink: 0;
      border: 1px solid;
    }
    .cat-model { color: var(--cat-model); border-color: rgba(59,130,246,0.3); background: rgba(59,130,246,0.08); }
    .cat-dax   { color: var(--cat-dax);   border-color: rgba(139,92,246,0.3); background: rgba(139,92,246,0.08); }
    .cat-report{ color: var(--cat-report);border-color: rgba(6,182,212,0.3);  background: rgba(6,182,212,0.08); }

    .finding-title-block { flex: 1; min-width: 0; }
    .finding-title {
      font-weight: 600;
      font-size: 14px;
      color: var(--text);
      margin-bottom: 4px;
    }
    .finding-location {
      font-size: 12px;
      color: var(--text-muted);
      font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace;
    }

    .finding-chevron {
      color: var(--text-dim);
      font-size: 12px;
      transition: transform var(--transition);
      flex-shrink: 0;
      margin-top: 2px;
    }
    .finding.open .finding-chevron { transform: rotate(180deg); }
    .finding.open .finding-header { background: var(--bg-card2); }

    .finding-body {
      border-top: 1px solid var(--border);
      padding: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s ease, padding 0.2s ease;
    }
    .finding.open .finding-body { max-height: 800px; padding: 20px; }

    .finding-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    @media (max-width: 700px) {
      .finding-grid { grid-template-columns: 1fr; }
      .cat-scores { grid-template-columns: 1fr; }
    }

    .finding-field label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-dim);
      display: block;
      margin-bottom: 6px;
    }
    .finding-field p {
      font-size: 13px;
      color: var(--text);
      line-height: 1.55;
    }
    .finding-field.full { grid-column: 1 / -1; }

    .evidence-block {
      background: var(--bg);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-sm);
      padding: 10px 14px;
      font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace;
      font-size: 12px;
      color: var(--accent);
      word-break: break-all;
    }

    .confidence-bar {
      height: 6px;
      background: var(--border);
      border-radius: 3px;
      margin-top: 6px;
      overflow: hidden;
    }
    .confidence-fill {
      height: 100%;
      border-radius: 3px;
      background: linear-gradient(90deg, #3b82f6, #8b5cf6);
    }

    .rule-id-chip {
      font-family: 'SF Mono', Consolas, monospace;
      font-size: 11px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 2px 8px;
      color: var(--text-muted);
    }

    /* ------------------------------------------------------------------ */
    /* Footer                                                               */
    /* ------------------------------------------------------------------ */
    footer {
      border-top: 1px solid var(--border);
      padding: 24px 0;
      margin-top: 48px;
      text-align: center;
      color: var(--text-dim);
      font-size: 12px;
    }

    /* ------------------------------------------------------------------ */
    /* Empty state                                                          */
    /* ------------------------------------------------------------------ */
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: var(--text-muted);
    }
    .empty-state .icon { font-size: 48px; margin-bottom: 16px; }
    .empty-state h3 { font-size: 18px; color: var(--text); margin-bottom: 8px; }

    /* ------------------------------------------------------------------ */
    /* Animations                                                           */
    /* ------------------------------------------------------------------ */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .finding { animation: fadeIn 0.3s ease both; }
    {% for i in range(1, 51) %}.finding:nth-child({{ i }}) { animation-delay: {{ (i * 0.03)|round(2) }}s; }{% endfor %}
  </style>
</head>
<body>

<!-- Header -->
<header>
  <div class="container">
    <div class="header-inner">
      <div class="brand">
        <div class="brand-icon">⚡</div>
        <div>
          <div class="brand-name">pbiscan</div>
          <div class="brand-sub">Power BI Report Quality &amp; Performance Scanner</div>
        </div>
      </div>
      <div class="header-meta">
        <div><strong style="color:var(--text)">{{ meta.report_name }}</strong></div>
        <div>Scanned {{ meta.scan_timestamp }}</div>
        <div>pbiscan {{ meta.scanner_version }}</div>
      </div>
    </div>
  </div>
</header>

<!-- Score Hero -->
<div class="container">
  <section class="score-hero">
    <h1 style="font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--text-muted);margin-bottom:20px;">Overall Health Score</h1>

    <div class="score-ring">
      <svg width="160" height="160" viewBox="0 0 160 160">
        <circle class="score-ring-bg" cx="80" cy="80" r="70"/>
        <circle
          class="score-ring-fill"
          cx="80" cy="80" r="70"
          stroke="{{ overall_colour }}"
          id="ringFill"
          style="stroke-dashoffset: {{ (439.82 * (1 - overall_score / 100))|round(2) }}"
        />
      </svg>
      <span class="score-value" style="color:{{ overall_colour }}">{{ overall_score|int }}</span>
    </div>

    <div class="score-label">
      {% if overall_score >= 80 %}<strong style="color:#22c55e">Good</strong> — Minor concerns only
      {% elif overall_score >= 60 %}<strong style="color:#f59e0b">Needs Attention</strong> — Review recommended
      {% else %}<strong style="color:#ef4444">Action Required</strong> — Significant issues detected
      {% endif %}
    </div>

    <!-- Category cards -->
    <div class="cat-scores">
      {% for cat_name, cat_data in category_scores.items() %}
      <div class="cat-card" style="border-top: 3px solid {{ cat_data.colour }};">
        <div class="cat-name">{{ cat_name }}</div>
        <div class="cat-score" style="color:{{ cat_data.colour }}">{{ cat_data.score }}</div>
        <div class="cat-bar">
          <div class="cat-bar-fill" style="width:{{ cat_data.score }}%;background:{{ cat_data.colour }};"></div>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- Summary strip -->
  <div class="summary-strip">
    <div class="stat-pill">
      <span class="count">{{ total_findings }}</span>
      <span class="label">Total Findings</span>
    </div>
    {% for sev, count in severity_counts.items() %}
    <div class="stat-pill" style="border-color:{{ severity_colours.get(sev,'#94a3b8') }}22;">
      <span class="count" style="color:{{ severity_colours.get(sev,'#94a3b8') }}">{{ count }}</span>
      <span class="label">{{ sev }}</span>
    </div>
    {% endfor %}
  </div>

  <!-- Filters -->
  {% if issues %}
  <div class="filters-bar">
    <span class="filter-label">Filter:</span>
    <button class="filter-btn active" onclick="filterFindings('all', this)" id="filter-all">All</button>
    <div class="filter-divider"></div>
    {% for cat in ['model', 'dax', 'report'] %}
    <button class="filter-btn" onclick="filterFindings('{{ cat }}', this)" id="filter-{{ cat }}">{{ cat|upper }}</button>
    {% endfor %}
    <div class="filter-divider"></div>
    {% for sev in ['WARNING', 'MEDIUM', 'ADVISORY'] %}
    <button class="filter-btn" onclick="filterFindings('{{ sev }}', this)" id="filter-{{ sev }}">{{ sev }}</button>
    {% endfor %}
  </div>
  {% endif %}

  <!-- Findings list -->
  <div class="section-title">
    Findings
    <span class="badge">{{ total_findings }}</span>
  </div>

  {% if issues %}
    {% for issue in issues %}
    <div class="finding" data-category="{{ issue.category }}" data-severity="{{ issue.severity }}" id="finding-{{ loop.index }}">
      <div class="finding-header" onclick="toggleFinding({{ loop.index }})">
        <span class="sev-badge" style="background:{{ severity_colours.get(issue.severity,'#94a3b8') }}22;color:{{ severity_colours.get(issue.severity,'#94a3b8') }};border:1px solid {{ severity_colours.get(issue.severity,'#94a3b8') }}44;">
          {{ issue.severity }}
        </span>
        <span class="cat-badge cat-{{ issue.category }}">{{ issue.category }}</span>
        <div class="finding-title-block">
          <div class="finding-title">{{ issue.title }}</div>
          {% if issue.location %}
          <div class="finding-location">{{ issue.location }}</div>
          {% endif %}
        </div>
        <span class="finding-chevron">▼</span>
      </div>
      <div class="finding-body">
        <div class="finding-grid">
          <div class="finding-field full">
            <label>Evidence</label>
            <div class="evidence-block">{{ issue.evidence }}</div>
          </div>
          <div class="finding-field">
            <label>Issue</label>
            <p>{{ issue.issue }}</p>
          </div>
          <div class="finding-field">
            <label>Impact</label>
            <p>{{ issue.impact }}</p>
          </div>
          <div class="finding-field full">
            <label>Recommendation</label>
            <p>{{ issue.recommendation }}</p>
          </div>
          <div class="finding-field">
            <label>Confidence — {{ issue.confidence }}%</label>
            <div class="confidence-bar">
              <div class="confidence-fill" style="width:{{ issue.confidence }}%;"></div>
            </div>
          </div>
          <div class="finding-field">
            <label>Rule ID</label>
            <span class="rule-id-chip">{{ issue.rule_id }}</span>
          </div>
        </div>
      </div>
    </div>
    {% endfor %}
  {% else %}
  <div class="empty-state">
    <div class="icon">✅</div>
    <h3>No findings detected</h3>
    <p>pbiscan did not detect any issues in this report.</p>
  </div>
  {% endif %}
</div>

<footer>
  <div class="container">
    Generated by <strong>pbiscan {{ meta.scanner_version }}</strong> · Deterministic static analysis · No AI or external connections used
  </div>
</footer>

<script>
  // Toggle individual finding accordion
  function toggleFinding(index) {
    const el = document.getElementById('finding-' + index);
    el.classList.toggle('open');
  }

  // Filter findings by category or severity
  let activeFilter = 'all';
  function filterFindings(filter, btn) {
    activeFilter = filter;
    // Update button states
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    document.querySelectorAll('.finding').forEach(f => {
      if (filter === 'all') {
        f.classList.remove('hidden');
      } else {
        const cat = f.dataset.category;
        const sev = f.dataset.severity;
        const match = (cat === filter.toLowerCase()) || (sev === filter.toUpperCase());
        f.classList.toggle('hidden', !match);
      }
    });
  }
</script>
</body>
</html>
