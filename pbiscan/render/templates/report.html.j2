{#- Static audit report. Palette, type and severity shapes follow pbiscan Studio
    (studio-ui/src/styles/studio.css, lib/severity.ts). No scripts: everything is
    visible as rendered, follows the reader's light/dark setting and prints cleanly. -#}
{%- macro marker(sev, size=12) -%}
{%- set h = size / 2 -%}
<svg class="mk sev-{{ sev|lower }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 {{ size }} {{ size }}" aria-hidden="true">
{%- set shape = severity_shapes.get(sev, 'ring') -%}
{%- if shape == 'diamond' -%}<path d="M{{ h }} 0.5 L{{ size - 0.5 }} {{ h }} L{{ h }} {{ size - 0.5 }} L0.5 {{ h }} Z" fill="currentColor"/>
{%- elif shape == 'tri' -%}<path d="M{{ h }} 1 L{{ size - 1 }} {{ size - 1.5 }} L1 {{ size - 1.5 }} Z" fill="currentColor"/>
{%- elif shape == 'square' -%}<rect x="2" y="2" width="{{ size - 4 }}" height="{{ size - 4 }}" fill="currentColor"/>
{%- elif shape == 'circle' -%}<circle cx="{{ h }}" cy="{{ h }}" r="{{ h - 1.5 }}" fill="currentColor"/>
{%- elif shape == 'dash' -%}<rect x="1.5" y="{{ h - 1.5 }}" width="{{ size - 3 }}" height="3" fill="currentColor"/>
{%- else -%}<circle cx="{{ h }}" cy="{{ h }}" r="{{ h - 2 }}" fill="none" stroke="currentColor" stroke-width="2"/>
{%- endif -%}
</svg>
{%- endmacro -%}
{%- macro finding_card(issue, anchor) -%}
<article class="finding panel" id="{{ anchor }}">
  <header class="f-head">
    <div class="f-meta">
      {{ marker(issue.severity) }}<span class="sev-tag sev-{{ issue.severity|lower }}">{{ issue.severity }}</span>
      <span>{{ issue.rule_id }}</span><span>· {{ area_labels.get(issue.category, issue.category) }}</span>
      <span class="conf">confidence {{ issue.confidence }}%<i><s style="width: {{ [[issue.confidence, 0]|max, 100]|min }}%"></s></i></span>
      {% if issue.suppressed %}<span class="chip">suppressed</span>{% endif %}
    </div>
    <h3>{{ issue.title }}</h3>
    {% if issue.location %}<div class="where">{{ issue.location }}</div>{% endif %}
  </header>
  <div class="f-body">
    {% if issue.issue %}<div class="blk"><div class="label">What pbiscan found</div><p>{{ issue.issue }}</p></div>{% endif %}
    {% if issue.evidence %}<div class="blk"><div class="label">Evidence</div><pre class="code">{{ issue.evidence }}</pre></div>{% endif %}
    {% if issue.impact %}<div class="blk"><div class="label">Why it matters</div><p>{{ issue.impact }}</p></div>{% endif %}
    {% if issue.recommendation %}<div class="blk"><div class="label">What to do</div><p>{{ issue.recommendation }}</p></div>{% endif %}
    {% if issue.suppressed and issue.suppression_reason %}<div class="notice">Suppressed: {{ issue.suppression_reason }}</div>{% endif %}
  </div>
</article>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{ meta.report_name }} · pbiscan audit</title>
  <meta name="description" content="Power BI quality audit of {{ meta.report_name }}, generated by pbiscan {{ meta.scanner_version }}">
  <style>
    :root {
      --paper: #EDF1F7; --panel: #FFFFFF; --panel-2: #E2E8F2;
      --ink: #0E1A2E; --ink-2: #3C4A63; --ink-3: #6F7E98;
      --rule: #D2DAE6; --rule-strong: #A7B4C8;
      --accent: #2D4BE0; --accent-soft: #DDE3FC; --good: #138A5E;
      --sev-critical: #C42A20; --sev-high: #E8641A; --sev-medium: #CC9500;
      --sev-warning: #D2427C; --sev-advisory: #677A94; --sev-low: #8C9AB0;
      --code-bg: #F5F7FB;
      --f-display: "Archivo Variable", "Archivo", "Arial Narrow", system-ui, sans-serif;
      --f-body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
      --f-mono: "IBM Plex Mono", ui-monospace, "Cascadia Mono", Consolas, monospace;
      --radius: 4px;
      color-scheme: light;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --paper: #0A1120; --panel: #101A2C; --panel-2: #17233A;
        --ink: #E7EDF7; --ink-2: #A7B4CA; --ink-3: #6E7D97;
        --rule: #1F2C45; --rule-strong: #31415F;
        --accent: #7D93FF; --accent-soft: #1C2A5C; --good: #3FCF8E;
        --sev-critical: #FF5A4E; --sev-high: #FF8C42; --sev-medium: #F2BE2E;
        --sev-warning: #F06BA3; --sev-advisory: #8C9DB8; --sev-low: #6E7D97;
        --code-bg: #0C1526;
        color-scheme: dark;
      }
    }

    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; }
    body { background: var(--paper); color: var(--ink); font-family: var(--f-body); font-size: 14px; line-height: 1.5; -webkit-font-smoothing: antialiased; }
    .wrap { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
    .label { font-family: var(--f-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--ink-3); font-weight: 500; }
    .panel { background: var(--panel); border: 1px solid var(--rule); border-radius: var(--radius); }
    .chip { font-family: var(--f-mono); font-size: 10.5px; font-weight: 500; padding: 1px 7px; border: 1px solid var(--rule-strong); border-radius: 99px; color: var(--ink-2); }

    /* Header */
    .top { border-bottom: 1px solid var(--rule); background: var(--panel); }
    .top .wrap { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; justify-content: space-between; padding-top: 14px; padding-bottom: 14px; }
    .brand { display: flex; align-items: center; gap: 10px; }
    .brand b { font-family: var(--f-display); font-stretch: 125%; font-weight: 750; font-size: 19px; letter-spacing: -.01em; }
    .brand small { font-family: var(--f-mono); font-size: 11px; color: var(--ink-3); }
    .project { min-width: 0; }
    .project h1 { margin: 0; font-family: var(--f-display); font-stretch: 118%; font-weight: 680; font-size: 17px; }
    .project .path, .project .when { font-family: var(--f-mono); font-size: 11px; color: var(--ink-3); overflow-wrap: anywhere; }

    /* Ledger */
    main.wrap { padding-top: 20px; padding-bottom: 32px; display: grid; gap: 16px; }
    .ledger { display: grid; grid-template-columns: auto minmax(0, 1.2fr) minmax(0, 1fr); }
    .ledger > section { padding: 18px 22px; display: grid; gap: 10px; align-content: start; min-width: 0; }
    .ledger > section + section { border-left: 1px solid var(--rule); }
    .score-row { display: flex; align-items: flex-end; gap: 10px; }
    .score { font-family: var(--f-display); font-stretch: 125%; font-weight: 780; font-size: 56px; line-height: .9; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
    .score-of { font-family: var(--f-mono); color: var(--ink-3); font-size: 12.5px; padding-bottom: 4px; }
    .grade { font-family: var(--f-display); font-stretch: 125%; font-weight: 700; font-size: 15px; border: 1.5px solid var(--ink); width: 30px; height: 30px; display: grid; place-items: center; margin-left: 6px; margin-bottom: 2px; }
    .verdict { font-size: 13px; color: var(--ink-2); }
    .cats { display: grid; gap: 9px; }
    .cat { display: grid; grid-template-columns: 56px minmax(0, 1fr) 44px; gap: 12px; align-items: center; font-size: 13px; }
    .cat .num { font-family: var(--f-mono); font-weight: 600; text-align: right; font-variant-numeric: tabular-nums; }
    .bar { position: relative; height: 12px; background: var(--panel-2); }
    .bar i { position: absolute; inset: 0 auto 0 0; background: var(--accent); }
    .bar::after { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(90deg, transparent 0 calc(5% - 2px), var(--panel) calc(5% - 2px) 5%); }
    .bar .target { position: absolute; top: -3px; bottom: -3px; left: 80%; width: 2px; background: var(--ink); z-index: 1; }
    .cat-note { font-family: var(--f-mono); font-size: 11px; color: var(--ink-3); display: flex; align-items: center; gap: 6px; }
    .cat-note i { width: 2px; height: 11px; background: var(--ink); }
    .sevs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 18px; }
    .sevs li { display: flex; align-items: center; gap: 8px; font-size: 13px; }
    .sevs li.zero { color: var(--ink-3); }
    .sevs b { margin-left: auto; font-family: var(--f-mono); font-weight: 600; font-variant-numeric: tabular-nums; }

    /* Severity colours and markers */
    .mk { flex: none; vertical-align: -1px; }
    .sev-critical { color: var(--sev-critical); } .sev-high { color: var(--sev-high); } .sev-medium { color: var(--sev-medium); }
    .sev-warning { color: var(--sev-warning); } .sev-advisory { color: var(--sev-advisory); } .sev-low { color: var(--sev-low); }
    .sev-tag { font-family: var(--f-mono); font-size: 10.5px; font-weight: 600; letter-spacing: .06em; }

    /* Findings */
    h2 { margin: 8px 0 0; font-family: var(--f-display); font-stretch: 118%; font-weight: 680; font-size: 22px; display: flex; align-items: baseline; gap: 10px; }
    h2 .label { font-size: 11px; }
    .finding { break-inside: avoid; }
    .f-head { padding: 14px 18px 12px; border-bottom: 1px solid var(--rule); }
    .f-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; font-family: var(--f-mono); font-size: 11.5px; color: var(--ink-3); }
    .f-head h3 { margin: 8px 0 2px; font-family: var(--f-display); font-stretch: 112%; font-weight: 650; font-size: 17px; line-height: 1.3; }
    .where { font-family: var(--f-mono); font-size: 12px; color: var(--ink-2); overflow-wrap: anywhere; }
    .conf { display: inline-flex; align-items: center; gap: 6px; }
    .conf i { display: inline-block; height: 3px; width: 40px; background: var(--rule); position: relative; }
    .conf s { position: absolute; inset: 0 auto 0 0; background: var(--ink-3); }
    .f-body { padding: 14px 18px 16px; display: grid; gap: 14px; }
    .blk { display: grid; gap: 6px; min-width: 0; }
    .blk p { margin: 0; color: var(--ink-2); max-width: 72ch; font-size: 13.5px; }
    pre.code { margin: 0; padding: 10px 12px; background: var(--code-bg); border: 1px solid var(--rule); border-radius: var(--radius); font-family: var(--f-mono); font-size: 12.5px; line-height: 1.55; white-space: pre-wrap; overflow-wrap: anywhere; color: var(--ink); }
    .notice { padding: 10px 14px; border: 1px solid var(--rule-strong); border-radius: var(--radius); font-size: 13px; color: var(--ink-2); }
    .list { display: grid; gap: 12px; }
    .empty { padding: 36px 20px; text-align: center; color: var(--ink-2); }
    .empty strong { display: block; font-family: var(--f-display); font-stretch: 118%; font-size: 17px; color: var(--ink); margin-bottom: 4px; }
    .suppressed .finding { opacity: .82; }
    .warnings { margin: 0; padding: 12px 18px 12px 34px; font-size: 13px; color: var(--ink-2); }
    footer { border-top: 1px solid var(--rule); padding: 18px 0 28px; font-family: var(--f-mono); font-size: 11px; color: var(--ink-3); }

    @media (max-width: 760px) {
      .ledger { grid-template-columns: minmax(0, 1fr); }
      .ledger > section + section { border-left: 0; border-top: 1px solid var(--rule); }
      .ledger > section { padding: 16px; }
      .score { font-size: 48px; }
      .f-head, .f-body { padding-left: 14px; padding-right: 14px; }
    }
    @media print {
      @page {
        size: A4;
        margin: 14mm 16mm;
      }
      :root {
        --paper: #ffffff;
        --panel: #ffffff;
        --panel-2: #f3f4f6;
        --ink: #111827;
        --ink-2: #374151;
        --ink-3: #6b7280;
        --rule: #d1d5db;
        --rule-strong: #9ca3af;
        --code-bg: #f9fafb;
        color-scheme: light;
      }
      body {
        background: #ffffff;
        color: #111827;
        font-size: 11.5px;
        line-height: 1.45;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .wrap { max-width: 100%; padding: 0; }
      .top { border-bottom: 2px solid var(--ink); background: none; }
      .top .wrap { padding-top: 8px; padding-bottom: 8px; }
      .exec-summary {
        break-after: page;
        page-break-after: always;
        padding-bottom: 16px;
      }
      .exec-highlights {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-top: 14px;
      }
      .exec-kpi {
        padding: 12px 14px;
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        background: var(--code-bg);
      }
      .exec-kpi .val {
        font-family: var(--f-display);
        font-size: 20px;
        font-weight: 700;
        margin-top: 4px;
        color: var(--ink);
      }
      .exec-kpi .sub {
        font-size: 11px;
        color: var(--ink-3);
        margin-top: 2px;
      }
      .ledger { border: 1px solid var(--rule); }
      .finding {
        break-inside: avoid;
        page-break-inside: avoid;
        margin-bottom: 12px;
        border: 1px solid var(--rule);
      }
      h2 {
        break-after: avoid;
        page-break-after: avoid;
        margin-top: 16px;
        font-size: 18px;
      }
      footer {
        break-inside: avoid;
        page-break-inside: avoid;
      }
    }
  </style>
</head>
<body>
<header class="top">
  <div class="wrap">
    <div class="brand">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 21 7v10l-9 5-9-5V7z" fill="var(--accent)"/><path d="M12 12 21 7M12 12v10M12 12 3 7" stroke="var(--panel)" stroke-width="1.5" fill="none"/></svg>
      <b>pbiscan</b><small>audit</small>
    </div>
    <div class="project">
      <h1>{{ meta.report_name }}</h1>
      {% if meta.source_path %}<div class="path">{{ meta.source_path }}</div>{% endif %}
      <div class="when">{% if meta.scan_timestamp %}Scanned {{ meta.scan_timestamp }} · {% endif %}pbiscan {{ meta.scanner_version }}</div>
    </div>
  </div>
</header>

<main class="wrap">
  <div class="exec-summary">
    <div class="ledger panel">
      <section aria-label="Overall score">
        <div class="label">Model health</div>
        <div class="score-row">
          <div class="score">{{ '%.1f'|format(overall_score) }}</div>
          <div class="score-of">/ 100</div>
          <div class="grade" title="Grade">{{ grade }}</div>
        </div>
        <div class="verdict">{{ verdict }}</div>
      </section>
      <section aria-label="Category scores">
        <div class="label">By area</div>
        <div class="cats">
          {% for cat in categories %}
          <div class="cat">
            <span>{{ cat.label }}</span>
            <span class="bar" role="img" aria-label="{{ cat.label }} {{ '%.1f'|format(cat.score) }} of 100, target {{ target }}"><i style="width: {{ [[cat.score, 0]|max, 100]|min }}%"></i><span class="target" style="left: {{ target }}%"></span></span>
            <b class="num">{{ '%.1f'|format(cat.score) }}</b>
          </div>
          {% endfor %}
        </div>
        <div class="cat-note"><i></i>target {{ target }}</div>
      </section>
      <section aria-label="Findings by severity">
        <div class="label">{{ open_issues|length }} open finding{{ '' if open_issues|length == 1 else 's' }}{% if suppressed_issues %} · {{ suppressed_issues|length }} suppressed{% endif %}</div>
        <ul class="sevs">
          {% for sev in severity_order %}
          <li class="{{ '' if severity_counts.get(sev) else 'zero' }}">{{ marker(sev) }}{{ sev|capitalize }}<b>{{ severity_counts.get(sev, 0) }}</b></li>
          {% endfor %}
        </ul>
      </section>
    </div>

    <div class="exec-highlights">
      <div class="exec-kpi">
        <div class="label">Quality Gate</div>
        <div class="val" style="color: {{ 'var(--good)' if overall_score >= target else 'var(--sev-high)' }};">
          {{ 'PASSED' if overall_score >= target else 'NEEDS REMEDIATION' }}
        </div>
        <div class="sub">Benchmark target: {{ target }}.0 / 100</div>
      </div>
      <div class="exec-kpi">
        <div class="label">Active Findings</div>
        <div class="val">{{ open_issues|length }}</div>
        <div class="sub">{% if suppressed_issues %}{{ suppressed_issues|length }} suppressed via policy{% else %}No active suppressions{% endif %}</div>
      </div>
      <div class="exec-kpi">
        <div class="label">Audit Integrity</div>
        <div class="val">Rule-based</div>
        <div class="sub">Findings come from fixed rules</div>
      </div>
    </div>
  </div>

  {% if warnings %}
  <div class="panel">
    <ul class="warnings">{% for w in warnings %}<li>{{ w }}</li>{% endfor %}</ul>
  </div>
  {% endif %}

  <h2>Findings <span class="label">most severe first</span></h2>
  {% if open_issues %}
  <div class="list">
    {% for issue in open_issues %}{{ finding_card(issue, 'finding-' ~ loop.index) }}{% endfor %}
  </div>
  {% else %}
  <div class="panel empty"><strong>No open findings</strong>This project passes every rule pbiscan checks.</div>
  {% endif %}

  {% if suppressed_issues %}
  <h2>Suppressed <span class="label">from pbiscan.suppressions.json</span></h2>
  <div class="list suppressed">
    {% for issue in suppressed_issues %}{{ finding_card(issue, 'suppressed-' ~ loop.index) }}{% endfor %}
  </div>
  {% endif %}
</main>

<footer>
  <div class="wrap">Generated by pbiscan {{ meta.scanner_version }} · deterministic static analysis of the project files; nothing was sent anywhere.</div>
</footer>
</body>
</html>
