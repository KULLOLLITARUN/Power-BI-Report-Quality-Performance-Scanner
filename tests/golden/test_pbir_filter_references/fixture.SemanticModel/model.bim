{
  "name": "fixture",
  "compatibilityLevel": 1550,
  "model": {
    "culture": "en-US",
    "tables": [
      {
        "name": "Sales",
        "columns": [
          {
            "name": "ID",
            "dataType": "int64",
            "sourceColumn": "ID"
          },
          {
            "name": "Amount",
            "dataType": "double",
            "sourceColumn": "Amount"
          }
        ],
        "measures": [
          {
            "name": "TotalSales",
