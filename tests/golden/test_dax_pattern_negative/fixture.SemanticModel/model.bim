{
  "_comment": "GOLDEN FIXTURE (critical negative): D001 must NOT fire. Sequential CALCULATE calls, pattern text inside a string literal, and commented-out EARLIER are not suspicious.",
  "model": {
    "tables": [
      {
        "name": "Sales",
        "columns": [
          {
            "name": "Amount",
            "dataType": "decimal",
            "sourceColumn": "Amount"
          },
          {
            "name": "Region",
            "dataType": "string",
            "sourceColumn": "Region"
          }
        ],
        "measures": [
          {
            "name": "Total Revenue",
            "expression": "IF(ISBLANK(SUM(Sales[Amount])), \"Avoid FILTER(ALL(x)) and EARLIER( here\", SUM(Sales[Amount])) -- EARLIER(Sales[Amount]) was removed"
          },
          {
            "name": "Revenue Filtered",
            "expression": "CALCULATE(SUM(Sales[Amount]), Sales[Region] = \"East\") + CALCULATE(SUM(Sales[Amount]), Sales[Region] = \"West\")"
          }
        ],
        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source = Table.FromRows({}) in Source"
            }
          }
        ]
      },
