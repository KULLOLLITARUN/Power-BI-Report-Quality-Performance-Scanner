{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.2.0/schema.json",
  "name": "metricChart",
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "queryRef": "DimProduct.Category",
              "field": {
                "Column": {
                  "Expression": {"SourceRef": {"Entity": "DimProduct"}},
                  "Property": "Category"
                }
              }
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "queryRef": "DynamicMetrics.DynamicMetrics Fields",
              "field": {
                "Column": {
                  "Expression": {"SourceRef": {"Entity": "DynamicMetrics"}},
                  "Property": "DynamicMetrics Fields"
                }
              }
            }
          ]
        }
      }
    }
  }
}
