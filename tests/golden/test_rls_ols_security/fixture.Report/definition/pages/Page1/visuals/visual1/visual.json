{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.2.0/schema.json",
  "name": "salesByRegionVisual",
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "queryRef": "Sales.Region",
              "field": {
                "Column": {
                  "Expression": {"SourceRef": {"Entity": "Sales"}},
                  "Property": "Region"
                }
              }
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "queryRef": "Sales.TotalSales",
              "field": {
                "Measure": {
                  "Expression": {"SourceRef": {"Entity": "Sales"}},
                  "Property": "TotalSales"
                }
              }
            }
          ]
        }
      }
    }
  }
}
