{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.2.0/schema.json",
  "name": "executiveTargetChart",
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "queryRef": "DimDate.Year",
              "field": {
                "Column": {
                  "Expression": {"SourceRef": {"Entity": "DimDate"}},
                  "Property": "Year"
                }
              }
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "queryRef": "FactSales.Final_Executive_Target_Growth",
              "field": {
                "Measure": {
                  "Expression": {"SourceRef": {"Entity": "FactSales"}},
                  "Property": "Final_Executive_Target_Growth"
                }
              }
            }
          ]
        }
      }
    }
  }
}
