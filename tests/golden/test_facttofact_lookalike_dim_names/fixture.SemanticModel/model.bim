          {"name": "OrderAmount", "dataType": "decimal", "sourceColumn": "OrderAmount"}
        ],
        "measures": [
          {"name": "Total Refunds", "expression": "SUM(Refunds[OrderAmount])"}
        ],
        "partitions": [{"name": "Refunds", "mode": "import", "source": {"type": "m", "expression": "let Source = Table.FromRows({}) in Source"}}]
      },
      {
