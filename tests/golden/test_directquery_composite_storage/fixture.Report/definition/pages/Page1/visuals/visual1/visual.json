{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.2.0/schema.json",
  "name": "compositeVisual",
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "queryRef": "DimCustomer.Segment",
              "field": {
                "Column": {
                  "Expression": {"SourceRef": {"Entity": "DimCustomer"}},
                  "Property": "Segment"
                }
              }
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "queryRef": "FactSales.DirectQueryFilteredSales",
              "field": {
                "Measure": {
                  "Expression": {"SourceRef": {"Entity": "FactSales"}},
                  "Property": "DirectQueryFilteredSales"
                }
              }
            }
          ]
        }
      }
    }
  }
}
